; Project-authored BYE5 machine insert for the cpmsim modem device.
; The BYE5 core selects direct or Hayes behavior through IMODEM/B5IM.
MDINST: IN 46H
        ANI 1
        RET
MDOUTST: IN 46H
        ANI 2
        RET
MDINP:  IN 46H
        ANI 1
        RZ
        IN 47H
        RET
MDOUTP: OUT 47H
        RET
MDCARCK: IN 46H
        ANI 4
        RET
MDINIT: CALL WXINIT
        CALL WXASTART
        CALL WXRESET
        PUSH H
        LHLD WXADDR
        MOV A,H
        ORA L
        POP H
        JNZ MDRDY
        LXI H,WXERROR
        CALL PRINTL
        JMP EXCPM
MDRDY:  CALL WXWORK
        JZ MDWORKOK
        PUSH PSW
        LXI H,WXWFAIL
        CALL PRINTL
        POP PSW
        ADI '0'
        MOV C,A
        CALL CONOUT
        LXI H,WXWSTOP
        CALL PRINTL
        JMP EXCPM
MDWORKOK: MVI A,3
        OUT 48H
        IF B5IM
        JMP IMINIT
        ENDIF
        LXI H,MDREADY
        CALL PRINTL
        RET
MDQUIT:
MDSTOP: XRA A
        OUT 48H
        RET
; Preserve the original no-activity reset points, including requests for
; input, input ready and every output character. No BDOS re-entry here.
WXIDRESET:PUSH PSW
        LDA TOVAL
        STA TOCNTM
        XRA A
        OUT 4AH
        POP PSW
        RET
; A keyboard-status query must never wait a millisecond merely because no
; input is ready. The paired reads latch elapsed whole host-clock minutes.
WXIDPOLL:PUSH B
        IN 4AH
        MOV B,A
        IN 4AH
        ORA A
        JNZ WXIDEXP
        LDA TOVAL
        ORA A
        JZ WXIDLEFT
        CMP B
        JC WXIDEXP
        JZ WXIDEXP
WXIDLEFT:SUB B
        MOV B,A
        LDA TOCNTM
        CMP B
        JZ WXIDRET
        MOV A,B
        STA TOCNTM
        MVI A,7
        CALL MDOUTP
WXIDRET:POP B
        XRA A
        RET
WXIDEXP:POP B
        JMP TMOUT
; TOVAL=0 retains the legacy 8-bit countdown's 256-minute interpretation.
; The elapsed-minute high byte expires that case without a wraparound.
; The emulated serial link has no baud clock. Report successful selection.
SET300:
SET450:
SET600:
SET710:
SET1200:
SET2400:
SET4800:
SET9600:
SET19200:
        XRA A
        RET

WXERROR: DB 13,10,'RCP/M requires a valid Z3PLUS environment.',13,10,0
MDREADY: DB 13,10,'RCP/M modem ready.',13,10,0
