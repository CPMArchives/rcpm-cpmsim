; Project-authored CP/M 3 WORK cleanup. Called after the previous call is
; disconnected, before modem initialization enables answering. Never edits
; the disk image from the host while CP/M has it logged in.
WXWORK: PUSH B
        PUSH D
        PUSH H
        MVI C,45
        MVI E,0FFH
        CALL REALBD
        MVI C,32
        MVI E,0FFH
        CALL REALBD
        STA WXWUSER
        MVI C,32
        MVI E,0
        CALL REALBD
        MVI A,1
        STA WXWERR
        LXI H,1025
        SHLD WXWLEFT
        LXI H,WXWFCB
        MVI M,9
        INX H
        MVI B,11
        MVI A,'?'
WXWNAME: MOV M,A
        INX H
        DCR B
        JNZ WXWNAME
        MVI B,24
        XRA A
WXWZERO: MOV M,A
        INX H
        DCR B
        JNZ WXWZERO
        LXI D,WXWBUF
        MVI C,26
        CALL REALBD
        CALL WXWFIND
        CPI 0FFH
        JNZ WXWERASE
        MOV A,H
        ORA A
        JNZ WXWEND
        JMP WXWOK
WXWERASE: MOV L,A
        MVI H,0
        DAD H
        DAD H
        DAD H
        DAD H
        DAD H
        LXI D,WXWBUF+1
        DAD D
        PUSH H
        LXI H,WXWONE
        MVI M,9
        INX H
        MVI B,35
        XRA A
WXWONEZ: MOV M,A
        INX H
        DCR B
        JNZ WXWONEZ
        POP H
        LXI D,WXWONE+1
        MVI B,11
WXWCOPY: MOV A,M
        ANI 7FH
        STAX D
        INX H
        INX D
        DCR B
        JNZ WXWCOPY
        LHLD WXWLEFT
        DCX H
        SHLD WXWLEFT
        MOV A,H
        ORA L
        JZ WXWEND
        MVI A,2
        STA WXWERR
        LXI D,WXWONE
        MVI C,30
        CALL REALBD
        CPI 0FFH
        JZ WXWEND
        MVI A,3
        STA WXWERR
        LXI D,WXWONE
        MVI C,19
        CALL REALBD
        CPI 0FFH
        JZ WXWEND
        MVI A,4
        STA WXWERR
        CALL WXWFIND
        CPI 0FFH
        JNZ WXWERASE
        MOV A,H
        ORA A
        JNZ WXWEND
WXWOK:  MVI A,5
        STA WXWERR
        MVI C,48
        MVI E,0
        CALL REALBD
        ORA A
        JNZ WXWEND
        STA WXWERR
WXWEND: LXI D,80H
        MVI C,26
        CALL REALBD
        LDA WXWUSER
        MOV E,A
        MVI C,32
        CALL REALBD
        MVI C,45
        MVI E,0
        CALL REALBD
        POP H
        POP D
        POP B
        LDA WXWERR
        ORA A
        RET
WXWFIND: LXI D,WXWFCB
        MVI C,17
        JMP REALBD
WXWUSER: DB 0
WXWERR: DB 1
WXWLEFT: DW 0
; Explicit I: (drive code 9), current user deliberately set to zero.
WXWFCB: DB 9,'???????????'
        DS 24
WXWONE: DS 36
WXWBUF: DS 128
WXWFAIL: DB 13,10,'WORK cleanup failed (step ',0
WXWSTOP: DB '); answering disabled.',13,10,0
