; Project-authored Z3PLUS wheel adapter. No fixed runtime addresses.
; Z3LIB GETWHL uses ENV+29h for the wheel pointer. Validate signature,
; environment type and ENV's self pointer before adopting a candidate.
; This is guest command policy, not a host security boundary.
WXINIT: PUSH PSW
        PUSH B
        PUSH D
        PUSH H
        LXI H,0
        SHLD WXADDR
        SHLD WXENV
        LXI H,8000H
WXLOOP: MOV A,M
        CPI 0C3H
        JNZ WXSKIP
        PUSH H
        LXI B,3
        DAD B
        MOV A,M
        CPI 'Z'
        JNZ WXNEXT
        INX H
        MOV A,M
        CPI '3'
        JNZ WXNEXT
        INX H
        MOV A,M
        CPI 'E'
        JNZ WXNEXT
        INX H
        MOV A,M
        CPI 'N'
        JNZ WXNEXT
        INX H
        MOV A,M
        CPI 'V'
        JNZ WXNEXT
        INX H
        MOV A,M
        CPI 80H
        JNZ WXNEXT
        POP H
        PUSH H
        LXI B,1BH
        DAD B
        MOV E,M
        INX H
        MOV D,M
        POP H
        PUSH H
        MOV A,L
        CMP E
        JNZ WXNEXT
        MOV A,H
        CMP D
        JNZ WXNEXT
        LXI B,29H
        DAD B
        MOV E,M
        INX H
        MOV D,M
        MOV A,D
        CPI 80H
        JC WXNEXT
        XCHG
        SHLD WXADDR
        MOV A,M
        STA WXLOCAL
        POP H
        SHLD WXENV
        JMP WXDONE
WXNEXT: POP H
WXSKIP: INX H
        MOV A,H
        CPI 0FFH
        JNZ WXLOOP
WXDONE: POP H
        POP D
        POP B
        POP PSW
        RET
; Getter returns A; all upstream uses immediately test A with ORA.
WXGET:  PUSH H
        LHLD WXADDR
        MOV A,H
        ORA L
        JZ WXFALL
        MOV A,M
        POP H
        RET
WXFALL: LDA WXLOCAL
        POP H
        RET
; Setter preserves registers and flags, like the original STA instruction.
WXSET:  STA WXLOCAL
        PUSH PSW
        PUSH H
        LHLD WXADDR
        MOV A,H
        ORA L
        JZ WXSDONE
        LDA WXLOCAL
        MOV M,A
WXSDONE: CALL WXPATH
        POP H
        POP PSW
        RET
WXADDR: DW 0
WXLOCAL: DB 0
WXDRIVE: DB 15
WXUSER: DB 16
WXSPD:  DB 0
WXENV:  DW 0
; ENV+9 contains the external path pointer, +11 its entry capacity.
; Only A0: is searched for callers; private mode also searches I13:.
; No current-directory wildcard: this is lookup convenience, not authority.
WXPATH: PUSH PSW
        PUSH B
        PUSH D
        PUSH H
        LHLD WXENV
        MOV A,H
        ORA L
        JZ WXPDONE
        LXI D,9
        DAD D
        MOV E,M
        INX H
        MOV D,M
        INX H
        MOV A,M
        CPI 3
        JC WXPDONE
        MOV A,D
        CPI 80H
        JC WXPDONE
        XCHG
        MVI M,1
        INX H
        MVI M,0
        INX H
        LDA WXLOCAL
        ORA A
        JZ WXPTAIL
        MVI M,9
        INX H
        MVI M,13
        INX H
WXPTAIL:MVI M,0
WXPDONE:POP H
        POP D
        POP B
        POP PSW
        RET
; Reset host service drafts/staging handles at call boundaries, not on
; private blank/unblank. The host reset does not touch committed files.
WXRESET: PUSH PSW
        CALL WXRBCLEAR
        XRA A
        STA WXRBENTRY
        OUT 49H
        POP PSW
        JMP WXCLR
; Discard the complete pending command line at lifecycle boundaries.
; GETCL1 in Z3LIB specifies ENV+18h = buffer address, +1Ah = capacity.
; Preserve the capacity byte, reset next-character to buffer+4, clear
; dummy count and first character. No fixed runtime buffer address.
WXCLR:  PUSH PSW
        PUSH B
        PUSH D
        PUSH H
        LHLD WXENV
        MOV A,H
        ORA L
        JZ WXCDONE
        LXI D,18H
        DAD D
        MOV E,M
        INX H
        MOV D,M
        INX H
        MOV A,M
        ORA A
        JZ WXCDONE
        MOV C,A
        MVI B,0
        MOV A,D
        CPI 80H
        JC WXCDONE
        XCHG
        PUSH H
        DAD B
        JC WXCOFLOW
        LXI B,4
        DAD B
        POP H
        JC WXCDONE
        PUSH H
        DAD B
        XCHG
        POP H
        MOV M,E
        INX H
        MOV M,D
        INX H
        INX H
        MVI M,0
        INX H
        MVI M,0
        JMP WXCDONE
WXCOFLOW: POP H
WXCDONE: POP H
        POP D
        POP B
        POP PSW
        RET
