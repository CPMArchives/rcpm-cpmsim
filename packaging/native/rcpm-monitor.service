[Unit]
Description=RCP/M local health and storage checks
After=rcpm.service

[Service]
Type=oneshot
User=rcpm
Group=rcpm
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/rcpm/rcpm_monitor.py check
TimeoutStartSec=90
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/rcpm/monitor
RestrictAddressFamilies=AF_UNIX AF_INET
SyslogIdentifier=rcpm-monitor
