+
+/* RCP/M mount port, scoped to the read-only J: archive slot. */
+static char volume_name[9];
+static size_t volume_length;
+static BYTE mount_status = 1;
+static int invalid_volume_name;
+
+static BYTE mount_in(void)
+{
+	return mount_status;
+}
+
+static void mount_out(BYTE data)
+{
+	char path[sizeof("volumes/XXXXXXXX.dsk")];
+	struct stat info;
+	int replacement;
+
+	if (data == 0xff) {
+		volume_length = 0;
+		invalid_volume_name = 0;
+		mount_status = 1;
+		return;
+	}
+	if (data != 0) {
+		if (volume_length == sizeof(volume_name) - 1 ||
+		    !((data >= 'A' && data <= 'Z') ||
+		      (data >= '0' && data <= '9') || data == '_'))
+			invalid_volume_name = 1;
+		else
+			volume_name[volume_length++] = (char) data;
+		return;
+	}
+	if (invalid_volume_name || volume_length == 0) {
+		mount_status = 1;
+		return;
+	}
+	volume_name[volume_length] = '\0';
+	(void) snprintf(path, sizeof(path), "volumes/%s.dsk", volume_name);
+	mount_status = 2;
+	replacement = open(path, O_RDONLY | O_NONBLOCK);
+	if (replacement == -1)
+		return;
+	if (fstat(replacement, &info) == -1 || !S_ISREG(info.st_mode) ||
+	    info.st_size != 255L * 128 * 128 || disks[9].fd == NULL) {
+		close(replacement);
+		return;
+	}
+	close(drivej);
+	drivej = replacement;
+	mount_status = 0;
+}
 
