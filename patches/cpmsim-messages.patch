+/* MESSAGE holds the draft in guest-session memory until the caller saves it. */
+static BYTE message_text[20 * 74];
+static size_t message_length;
+static BYTE message_status;
+
+static int write_message(FILE *file)
+{
+	return fwrite(message_text, 1, message_length, file) == message_length ? 0 : -1;
+}
+
+static BYTE message_in(void)
+{
+	return message_status;
+}
+
+static void message_out(BYTE data)
+{
+	if (data == 0xff) {
+		message_length = 0;
+		message_status = 0;
+		return;
+	}
+	if (data == 0) {
+		if (message_status == 0 && message_length != 0 &&
+		    save_inbox("MESSAGE.TXT", write_message) != 0)
+			message_status = 2;
+		message_length = 0;
+		return;
+	}
+	if (message_length == sizeof(message_text) ||
+	    ((data < 32 || data > 126) && data != '\r' && data != '\n'))
+		message_status = 1;
+	else
+		message_text[message_length++] = data;
+}
