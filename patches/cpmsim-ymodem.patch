+
+/* YMODEM uploads commit one file at a time, before its end-of-file ACK. */
+enum { Y_STX = 2, Y_MAX = 4 * 1024 * 1024 };
+static size_t y_remaining;
+
+static int read_y_packet(BYTE start, BYTE *number, BYTE *body, size_t *length)
+{
+	BYTE frame[2 + 1024 + 2];
+
+	if (start != X_SOH && start != Y_STX)
+		return -1;
+	*length = start == X_SOH ? 128 : 1024;
+	if (upload_read(frame, *length + 4, 10000) != 0)
+		return -1;
+	if ((frame[0] ^ frame[1]) != 0xff ||
+	    upload_crc(frame + 2, *length) !=
+	    ((unsigned int) frame[*length + 2] << 8 | frame[*length + 3]))
+		return 1;
+	*number = frame[0];
+	memcpy(body, frame + 2, *length);
+	return 0;
+}
+
+static int receive_y_file(FILE *file)
+{
+	BYTE first, number, block = 1, body[1024];
+	size_t length, count;
+	int result, errors = 0, received = 0;
+
+	if (upload_signal(X_ACK) != 0 || upload_signal('C') != 0)
+		return -1;
+	for (;;) {
+		if (upload_read(&first, 1, 10000) != 0)
+			return -1;
+		if (first == X_EOT) {
+			if (y_remaining != 0 || upload_signal(X_NAK) != 0 ||
+			    upload_read(&first, 1, 10000) != 0 || first != X_EOT)
+				return -1;
+			return 0;
+		}
+		result = read_y_packet(first, &number, body, &length);
+		if (result < 0)
+			return -1;
+		if (result != 0 || (number != block && number != (BYTE)(block - 1))) {
+			if (++errors == 10 || upload_signal(X_NAK) != 0)
+				return -1;
+			continue;
+		}
+		if (number == block) {
+			if (y_remaining == 0)
+				return -1;
+			count = length < y_remaining ? length : y_remaining;
+			if (fwrite(body, 1, count, file) != count)
+				return -1;
+			y_remaining -= count;
+			block++;
+			received = 1;
+		}
+		errors = 0;
+		if (upload_signal(X_ACK) != 0 || (!received && upload_signal('C') != 0))
+			return -1;
+	}
+}
+
+static int parse_y_header(const BYTE *body, size_t length)
+{
+	const BYTE *zero = memchr(body, 0, length);
+	const BYTE *size;
+	size_t i, bytes = 0;
 
+	if (zero == NULL || zero == body || (size_t)(zero - body) >= sizeof(upload_name))
+		return -1;
+	for (i = 0; body + i < zero; i++) {
+		BYTE ch = body[i];
+
+		if (ch >= 'a' && ch <= 'z')
+			ch -= 'a' - 'A';
+		if (!volume_character(ch) && ch != '.')
+			return -1;
+		upload_name[i] = (char) ch;
+	}
+	upload_name[i] = '\0';
+	if (!valid_upload_name(upload_name))
+		return -1;
+	size = zero + 1;
+	if (size == body + length || *size < '0' || *size > '9')
+		return -1;
+	while (size < body + length && *size >= '0' && *size <= '9') {
+		bytes = bytes * 10 + (*size++ - '0');
+		if (bytes > Y_MAX)
+			return -1;
+	}
+	if (size == body + length || (*size != ' ' && *size != '\0'))
+		return -1;
+	y_remaining = bytes;
+	return 0;
+}
+
+static int receive_y_batch(void)
+{
+	BYTE first, number, body[1024];
+	size_t length;
+	int result, retries, request = 'C';
+	const char ready[] = "\r\nReady for YMODEM batch upload.\r\n";
+
+	if (access("upload-staging", W_OK) != 0 ||
+	    write(STDOUT_FILENO, ready, sizeof(ready) - 1) != sizeof(ready) - 1)
+		return -1;
+	for (;;) {
+		for (retries = 0; retries < 10; retries++) {
+			if (upload_signal((BYTE)request) != 0)
+				return -1;
+			if (upload_read(&first, 1, 3000) != 0) {
+				request = 'C';
+				continue;
+			}
+			result = read_y_packet(first, &number, body, &length);
+			if (result < 0)
+				return -1;
+			if (result == 0 && number == 0)
+				break;
+			request = X_NAK;
+		}
+		if (retries == 10)
+			return -1;
+		if (body[0] == 0)
+			return upload_signal(X_ACK);
+		if (parse_y_header(body, length) != 0 ||
+		    save_inbox(upload_name, receive_y_file) != 0 ||
+		    upload_signal(X_ACK) != 0)
+			return -1;
+		request = 'C';
+	}
+}
