+/* Guest supplies file records from BDOS, including the currently mounted J:. */
+static FILE *y_source;
+static BYTE y_status = 1, y_tail;
+static char y_fcb[11];
+static size_t y_name_length;
+static long y_source_size;
+static int y_need_tail;
+
+static int write_y_packet(BYTE number, const BYTE *body, size_t length)
+{
+	BYTE frame[3 + 1024 + 2], response;
+	unsigned int crc = upload_crc(body, length);
+	int retries;
+
+	frame[0] = length == 128 ? X_SOH : Y_STX;
+	frame[1] = number;
+	frame[2] = number ^ 0xff;
+	memcpy(frame + 3, body, length);
+	frame[length + 3] = (BYTE)(crc >> 8);
+	frame[length + 4] = (BYTE)crc;
+	for (retries = 0; retries < 10; retries++) {
+		if (write(STDOUT_FILENO, frame, length + 5) != (ssize_t)(length + 5) ||
+		    upload_read(&response, 1, 10000) != 0)
+			return -1;
+		if (response == X_ACK)
+			return 0;
+		if (response != X_NAK && (response != 'C' || number != 0))
+			return -1;
+	}
+	return -1;
+}
+
+static int send_y_file(const char *name, long size)
+{
+	BYTE body[1024] = {0}, block = 1, response;
+	size_t count, length;
+	const char ready[] = "\r\nReady for YMODEM download.\r\n";
+
+	if (write(STDOUT_FILENO, ready, sizeof(ready) - 1) != sizeof(ready) - 1 ||
+	    upload_read(&response, 1, 30000) != 0 || response != 'C')
+		return -1;
+	(void) snprintf((char *)body, 128, "%s", name);
+	(void) snprintf((char *)body + strlen(name) + 1, 128 - strlen(name) - 1, "%ld", size);
+	if (write_y_packet(0, body, 128) != 0 ||
+	    upload_read(&response, 1, 10000) != 0 || response != 'C')
+		return -1;
+	while (size > 0) {
+		length = size > 128 ? 1024 : 128;
+		count = size < (long)length ? (size_t)size : length;
+		if (fread(body, 1, count, y_source) != count)
+			return -1;
+		memset(body + count, 0x1a, length - count);
+		if (write_y_packet(block++, body, length) != 0)
+			return -1;
+		size -= (long)count;
+	}
+	if (upload_signal(X_EOT) != 0 || upload_read(&response, 1, 10000) != 0)
+		return -1;
+	if (response == X_NAK &&
+	    (upload_signal(X_EOT) != 0 || upload_read(&response, 1, 10000) != 0))
+		return -1;
+	if (response != X_ACK || upload_read(&response, 1, 10000) != 0 || response != 'C')
+		return -1;
+	memset(body, 0, 128);
+	return write_y_packet(0, body, 128);
+}
+
+static int y_download_name(char *name)
+{
+	size_t i, index = 0;
+
+	for (i = 0; i < 11; i++) {
+		if (y_fcb[i] == ' ')
+			continue;
+		if (!volume_character((BYTE)y_fcb[i]))
+			return -1;
+		if (i >= 8 && index != 0 && !strchr(name, '.')) {
+			name[index++] = '.';
+			name[index] = '\0';
+		}
+		name[index++] = y_fcb[i];
+		name[index] = '\0';
+	}
+	return valid_upload_name(name) ? 0 : -1;
 }
 
+static void end_y_source(void)
+{
+	if (y_source != NULL) {
+		fclose(y_source);
+		y_source = NULL;
+	}
+}
+
+static BYTE y_send_in(void)
+{
+	return y_status;
+}
+
+static void y_send_out(BYTE data)
+{
+	char name[13] = {0};
+	long size;
+
+	if (data == 0xff) {
+		end_y_source();
+		y_source = tmpfile();
+		y_status = y_source == NULL;
+		y_source_size = 0;
+		y_name_length = 0;
+		y_need_tail = 0;
+		y_tail = 0;
+		return;
+	}
+	if (data == 0xfd) {
+		end_y_source();
+		y_status = 1;
+		return;
+	}
+	if (data == 0xfe) {
+		size = y_source_size;
+		if (y_tail && size >= 128)
+			size -= 128 - y_tail;
+		if (y_status == 0 && y_source != NULL && !y_need_tail &&
+		    y_name_length == sizeof(y_fcb) &&
+		    y_download_name(name) == 0 && fseek(y_source, 0, SEEK_SET) == 0) {
+			y_status = send_y_file(name, size) != 0;
+			if (y_status) {
+				(void) upload_signal(X_CAN);
+				(void) upload_signal(X_CAN);
+			}
+		} else
+			y_status = 1;
+		end_y_source();
+		return;
+	}
+	if (y_name_length < sizeof(y_fcb)) {
+		y_fcb[y_name_length++] = (char)data;
+		if (y_name_length == sizeof(y_fcb))
+			y_need_tail = 1;
+	} else if (y_need_tail) {
+		y_tail = data;
+		y_need_tail = 0;
+		if (y_tail > 127)
+			y_status = 1;
+	} else
+		y_status = 1;
+}
+
+static void y_data_out(BYTE data)
+{
+	if (y_status != 0)
+		return;
+	if (y_source == NULL || y_source_size >= 32L * 1024 * 1024 ||
+	    fputc(data, y_source) == EOF)
+		y_status = 1;
+	else
+		y_source_size++;
+}
